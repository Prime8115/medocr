# Copy to partner-deploy/.env. Never commit the filled file.
# Generate both secrets as shown in docs/SOHAMERP_SELF_HOSTING.md.
COMPOSE_PROJECT_NAME=mediscan
API_DOMAIN=api.example.com
WEB_DOMAIN=app.example.com
# Existing-proxy mode only. These ports bind to 127.0.0.1 on the server.
MEDISCAN_API_PORT=8090
MEDISCAN_WEB_PORT=8091
POSTGRES_PASSWORD=replace-with-48-random-hex-characters
DATABASE_URL=postgresql+psycopg2://mediscan:replace-with-48-random-hex-characters@db:5432/mediscan
JWT_SECRET=replace-with-a-separate-long-random-secret
GEMINI_API_KEY=replace-with-a-live-key
ENVIRONMENT=production
ALLOW_MOCK_OCR=false
CORS_ORIGINS=https://app.example.com
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/storage
# Optional encrypted retention of exact originals. Keep the key backed up.
SOURCE_ENCRYPTION_KEYS=
