# Copy to .env and fill in real values. NEVER commit the real .env.
ENVIRONMENT=development

# Security — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./mediscan_dev.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/mediscan

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# OCR (get a key from Google AI Studio)
GEMINI_API_KEY=
# Multi-key pool: comma-separated list of keys for round-robin rotation & 429 rate limit prevention
# GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...
OCR_MODEL=gemini-flash-lite-latest
OCR_MAX_CONCURRENT_JOBS=6
ALLOW_MOCK_OCR=false

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=

# Limits
MAX_UPLOAD_MB=15
RATE_LIMIT_PER_MINUTE=60
